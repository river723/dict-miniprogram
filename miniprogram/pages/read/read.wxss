.read { min-height: 100vh; }

.read__head { padding: 24rpx 32rpx 8rpx; }

/* ---------- Hero ---------- */
.hero {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 36rpx;
  border-radius: var(--mg-radius-xl);
  background: var(--mg-primary);
  box-shadow: var(--mg-shadow-card);
}

.hero__label {
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: rgba(255, 255, 255, 0.78);
}

.hero__divider {
  height: 1rpx;
  background: rgba(255, 255, 255, 0.2);
}

.hero__row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.hero__icon {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
}

.hero__name {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.hero__val {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.85);
}

/* ---------- 段切换 ---------- */
.seg {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin-top: 24rpx;
}

.seg__item {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 84rpx;
  border-radius: var(--mg-radius-lg);
  background: var(--mg-surface);
  border: 1rpx solid var(--mg-outline);
}

.seg__item--on {
  background: var(--mg-primary-container);
  border-color: var(--mg-primary);
}

.seg__label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--mg-text);
}

.seg__item--on .seg__label { color: var(--mg-primary); }

.seg__count {
  min-width: 40rpx;
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--mg-surface-alt);
}

.seg__item--on .seg__count { background: var(--mg-primary); }

.seg__count text {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--mg-text-3);
}

.seg__item--on .seg__count text { color: #FFFFFF; }

/* ---------- 列表 ---------- */
.list { padding: 16rpx 32rpx 0; }

.chapter {
  margin-bottom: 16rpx;
  padding: 26rpx;
  background: var(--mg-surface);
  border: 1rpx solid var(--mg-outline);
  border-radius: var(--mg-radius-lg);
}

.chapter__row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.chapter__num {
  flex-shrink: 0;
  min-width: 96rpx;
  height: 56rpx;
  padding: 0 12rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--mg-primary-container);
}

.chapter__num text {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--mg-primary);
  letter-spacing: 1rpx;
}

.chapter__title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 44rpx;
  color: var(--mg-text);
}

.chapter__meta {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
  padding-left: 112rpx;
}

.chapter__words {
  font-size: 22rpx;
  color: var(--mg-text-3);
}

.chapter__theme {
  background: var(--mg-surface-alt);
  color: var(--mg-text-2);
}

/* ---------- 文章 ---------- */
.article {
  margin-bottom: 16rpx;
  padding: 26rpx;
  background: var(--mg-surface);
  border: 1rpx solid var(--mg-outline);
  border-radius: var(--mg-radius-lg);
}

.article__head {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.article__title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 44rpx;
  color: var(--mg-text);
}

.article__del { flex-shrink: 0; padding: 4rpx; }

.article__meta {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--mg-text-3);
}

.article__preview {
  display: -webkit-box;
  margin-top: 12rpx;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  line-height: 42rpx;
  color: var(--mg-text-2);
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.article__foot {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.article__theme {
  background: var(--mg-primary-container);
  color: var(--mg-primary);
}

.article__wchip {
  background: var(--mg-surface-alt);
  color: var(--mg-text-2);
}

.article__more {
  font-size: 22rpx;
  color: var(--mg-text-3);
}

.bottomspace { height: 200rpx; }
