<view class="page">
  <view wx:if="{{series}}" class="mg-card head">
    <view class="title">{{series.series_title}}</view>
    <view class="mg-text-secondary">共 {{series.total_chapters}} 章 · 目标词融入短文，语境记忆</view>
  </view>
  <view wx:for="{{list}}" wx:key="id" class="mg-card item" data-id="{{item.id}}" bindtap="go">
    <view class="i-title">{{item.title}}</view>
    <view class="mg-text-secondary">{{item.summary}}</view>
    <view class="mg-text-tertiary meta">{{item.theme}} · {{item.word_count}} 词</view>
  </view>
</view>
