.page { padding: 32rpx; display: flex; flex-direction: column; gap: 16rpx; }
.head { display: flex; align-items: center; gap: 32rpx; padding: 48rpx 32rpx; }
.avatar { width: 112rpx; height: 112rpx; border-radius: 50%; background: var(--mg-primary); color: #fff;
          display: flex; align-items: center; justify-content: center; font-size: 48rpx; font-weight: 700; }
.nums { display: flex; flex-direction: column; gap: 8rpx; font-size: 26rpx; color: var(--mg-text-2); }
.row { display: flex; justify-content: space-between; }
