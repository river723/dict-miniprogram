<view class="page" wx:if="{{word}}">
  <view class="mg-card head">
    <view class="w">{{word.word}}</view>
    <view class="mg-text-tertiary meta">难度 {{word.difficulty}}/5 · 考频 {{word.frequency}}</view>
    <view class="defs">
      <view wx:for="{{word.definitions}}" wx:key="meaning" class="def">
        <text class="pos">{{item.part_of_speech || item.pos}}</text>{{item.meaning}}
      </view>
    </view>
  </view>

  <view class="mg-card">
    <view class="ai-head" bindtap="analyze">
      <text>AI 解析（熟词僻义 / 词根 / 记忆）</text>
      <text class="mg-text-tertiary">{{analyzing ? '生成中…' : (analysis ? '已生成' : '展开 ›')}}</text>
    </view>
    <block wx:if="{{analysis}}">
      <view wx:if="{{analysis.root_analysis}}" class="ai-block"><text class="lb">词根</text>{{analysis.root_analysis}}</view>
      <view wx:if="{{analysis.memory_tip}}" class="ai-block"><text class="lb">记忆</text>{{analysis.memory_tip}}</view>
      <view wx:for="{{analysis.obscure_meanings || []}}" wx:key="obscure" class="ai-block">
        <text class="lb">僻义</text>{{item.familiar}} → {{item.obscure}}：{{item.example}}
      </view>
      <view wx:for="{{analysis.definitions || []}}" wx:key="meaning" class="ai-block">
        <text class="lb">{{item.pos}}</text>{{item.meaning}}
      </view>
      <view wx:if="{{analysis.raw}}" class="ai-block">{{analysis.raw}}</view>
    </block>
  </view>

  <view class="mg-btn mg-btn-danger del" bindtap="remove">从生词本删除</view>
</view>
