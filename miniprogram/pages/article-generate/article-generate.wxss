.ag {
  min-height: 100vh;
  padding: 24rpx 32rpx 0;
  box-sizing: border-box;
}

/* ---------- Hero ---------- */
.ag__hero {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  padding: 40rpx;
  border-radius: var(--mg-radius-xl);
  background: var(--mg-primary);
  box-shadow: var(--mg-shadow-card);
}

.ag__hero-text { flex: 1; min-width: 0; }

.ag__hero-label {
  display: block;
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: rgba(255, 255, 255, 0.78);
}

.ag__hero-title {
  display: block;
  margin-top: 6rpx;
  font-size: 46rpx;
  line-height: 62rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.ag__hero-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.85);
}

.ag__hero-icon {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
}

/* ---------- 节 ---------- */
.sec { margin-top: 40rpx; margin-bottom: 16rpx; }

.card {
  padding: 28rpx;
  background: var(--mg-surface);
  border: 1rpx solid var(--mg-outline);
  border-radius: var(--mg-radius-lg);
  box-shadow: var(--mg-shadow-hairline);
}

.divider {
  height: 1rpx;
  margin: 16rpx 0;
  background: var(--mg-outline);
  opacity: 0.6;
}

/* ---------- 步进器 ---------- */
.stepper {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0;
}

.stepper__label { font-size: 27rpx; color: var(--mg-text); }

.stepper__ctrl {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
}

.stepper__btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--mg-radius-md);
  background: var(--mg-primary-container);
  font-size: 32rpx;
  font-weight: 700;
  color: var(--mg-primary);
}

.stepper__val {
  min-width: 140rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--mg-primary);
}

/* ---------- 分段 ---------- */
.seg2 {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
}

.seg2__item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 68rpx;
  border-radius: var(--mg-radius-md);
  font-size: 26rpx;
  font-weight: 600;
  color: var(--mg-text-2);
  background: var(--mg-surface-alt);
  border: 1rpx solid var(--mg-outline);
}

.seg2__item--on {
  background: var(--mg-primary);
  border-color: var(--mg-primary);
  color: #FFFFFF;
}

.ag__count {
  display: block;
  margin: 24rpx 0 16rpx;
  font-size: 25rpx;
  color: var(--mg-text-2);
}

.ag__warn {
  display: block;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  line-height: 36rpx;
  color: var(--mg-warning);
}

/* ---------- 词 chip ---------- */
.wgrid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
}

.wgrid--manual { margin-top: 20rpx; }

.witem { margin-bottom: 4rpx; }

.wchip {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: var(--mg-primary-container);
}

.wchip__text {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--mg-primary);
}

.wchip__x {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
}

.mchip {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--mg-text);
  background: var(--mg-bg);
  border: 1rpx solid var(--mg-outline);
}

.mchip--on {
  background: var(--mg-primary);
  border-color: var(--mg-primary);
  color: #FFFFFF;
}

.mchip--on .mchip__text { color: #FFFFFF; }

.textaction {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
  margin-top: 24rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--mg-primary);
}

.ag__search { margin-top: 4rpx; }

.ph { color: var(--mg-text-3); }

/* ---------- 主题 ---------- */
.tgrid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 14rpx;
}

.tchip {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--mg-text);
  background: var(--mg-surface-alt);
  border: 1rpx solid var(--mg-outline);
}

.tchip--on {
  background: var(--mg-primary);
  border-color: var(--mg-primary);
  color: #FFFFFF;
}

/* ---------- 状态 / 生成 ---------- */
.ag__err {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: 24rpx;
  font-size: 24rpx;
  line-height: 36rpx;
  color: var(--mg-danger);
  text-align: center;
}

.ag__gen { margin-top: 32rpx; }

.ag__genhint {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 32rpx 0;
  font-size: 27rpx;
  color: var(--mg-text-2);
}

.ag__genhint-sub { font-size: 22rpx; color: var(--mg-text-3); }

/* ---------- 预览 ---------- */
.preview__title {
  display: block;
  margin-bottom: 16rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--mg-text);
}

.preview__body {
  display: block;
  font-size: 29rpx;
  line-height: 50rpx;
  color: var(--mg-text-2);
}

.preview__body .hit {
  color: var(--mg-primary);
  font-weight: 800;
  text-decoration: underline;
}

.preview__tlabel {
  display: block;
  margin-bottom: 10rpx;
  font-size: 25rpx;
  font-weight: 600;
  color: var(--mg-primary);
}

.preview__trans {
  display: block;
  font-size: 28rpx;
  line-height: 48rpx;
  color: var(--mg-text-2);
}

.ag__actions {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin-top: 28rpx;
}

.ag__act-flex { flex: 1; min-width: 0; }

.ag__bottomspace { height: 80rpx; }
