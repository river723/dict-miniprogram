.es {
  min-height: 100vh;
  padding: 24rpx 32rpx 0;
  box-sizing: border-box;
}

/* ---------- Hero ---------- */
.es__hero {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
  min-height: 220rpx;
  padding: 36rpx;
  border-radius: var(--mg-radius-xl);
  background: var(--mg-primary);
  box-shadow: var(--mg-shadow-card);
}

.es__hero-text { flex: 1; min-width: 0; }

.es__hero-label {
  display: block;
  font-size: 22rpx;
  letter-spacing: 1rpx;
  color: rgba(255, 255, 255, 0.78);
}

.es__hero-title {
  display: block;
  margin-top: 6rpx;
  font-size: 42rpx;
  line-height: 58rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.es__hero-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 23rpx;
  line-height: 34rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 题数步进器 */
.es__stepper {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.es__stepper-label {
  font-size: 21rpx;
  font-weight: 600;
  letter-spacing: 0.6rpx;
  color: rgba(255, 255, 255, 0.78);
}

.es__stepper-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
}

.es__stepbtn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--mg-radius-sm);
  background: rgba(255, 255, 255, 0.22);
}

.es__stepbtn--off { opacity: 0.4; }

.es__numbadge {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 72rpx;
  height: 56rpx;
  padding: 0 16rpx;
  border-radius: var(--mg-radius-sm);
  background: rgba(255, 255, 255, 0.30);
}

.es__numbadge-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
}

/* ---------- 节 / 卡片 ---------- */
.sec { margin-top: 36rpx; margin-bottom: 12rpx; }

.card {
  padding: 28rpx;
  background: var(--mg-surface);
  border: 1rpx solid var(--mg-outline);
  border-radius: var(--mg-radius-lg);
  box-shadow: var(--mg-shadow-hairline);
}

.es__hint {
  display: block;
  margin-top: 20rpx;
  font-size: 24rpx;
  line-height: 36rpx;
  color: var(--mg-text-3);
}

/* ---------- 分段按钮 ---------- */
.seg2 {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
}

.seg2__item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 68rpx;
  border-radius: var(--mg-radius-md);
  font-size: 26rpx;
  font-weight: 600;
  color: var(--mg-text-2);
  background: var(--mg-surface-alt);
  border: 1rpx solid var(--mg-outline);
}

.seg2__item--on {
  background: var(--mg-primary);
  border-color: var(--mg-primary);
  color: #FFFFFF;
}

/* ---------- 选词 ---------- */
.es__count {
  display: block;
  margin: 24rpx 0 16rpx;
  font-size: 25rpx;
  color: var(--mg-text-2);
}

.es__warn {
  display: block;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  line-height: 36rpx;
  color: var(--mg-warning);
}

.wgrid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 14rpx;
}

.wgrid--manual { margin-top: 20rpx; }

.witem {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 4rpx;
  margin-bottom: 4rpx;
}

.wchip {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: var(--mg-primary-container);
}

.wchip__text {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--mg-primary);
}

.wchip__x {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28rpx;
  height: 28rpx;
}

.mchip {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: var(--mg-bg);
  border: 1rpx solid var(--mg-outline);
}

.mchip__text {
  font-size: 24rpx;
  color: var(--mg-text);
}

.mchip--on {
  background: var(--mg-primary);
  border-color: var(--mg-primary);
}

.mchip--on .mchip__text { color: #FFFFFF; }

/* 覆盖次数徽标 */
.cov {
  font-size: 19rpx;
  font-weight: 500;
  margin-left: 2rpx;
}
.cov--success { color: var(--mg-success); }
.cov--warning { color: var(--mg-warning); }
.cov--muted { color: var(--mg-text-3); }

.textaction {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 10rpx;
  margin-top: 24rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--mg-primary);
}

.es__search { margin-top: 4rpx; }

.ph { color: var(--mg-text-3); }

/* ---------- 出题按钮 ---------- */
.es__gen { margin-top: 32rpx; }

.es__genhint {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 28rpx 0;
  font-size: 26rpx;
  line-height: 40rpx;
  text-align: center;
  color: var(--mg-text-2);
}

.es__genhint-sub {
  display: block;
  margin-top: 16rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--mg-text-3);
}

.es__bottomspace { height: 80rpx; }
