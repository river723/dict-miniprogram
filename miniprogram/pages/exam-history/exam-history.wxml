<view class="mg-page eh {{themeClass}}">

  <mg-empty
    wx:if="{{items.length === 0}}"
    icon="clipboard-text-multiple"
    title="暂无练习记录"
    description="完成 AI 出题后，可在此回顾历史成绩与重做。"
    action-label="去做一组练习"
    bind:action="goSetup"
  />

  <block wx:else>
    <view
      wx:for="{{items}}"
      wx:key="key"
      class="eh__card"
      hover-class="mg-hover-soft"
      data-kind="{{item.kind}}"
      data-id="{{item.id}}"
      bindtap="onRowTap"
    >
      <view class="eh__row">
        <view class="eh__left">
          <text class="eh__date">{{item.dateText}}</text>
          <text class="eh__sub">{{item.detailText}}</text>
        </view>
        <view class="eh__right">
          <text class="eh__acc eh__acc--{{item.accuracyCls}}">{{item.accuracyText}}</text>
          <text class="eh__score">{{item.scoreText}}</text>
        </view>
      </view>

      <view class="eh__foot">
        <view
          class="eh__del"
          hover-class="mg-hover"
          data-kind="{{item.kind}}"
          data-id="{{item.id}}"
          catchtap="onDelete"
        >
          <mg-icon name="delete-outline" size="30" color="#8A8E89" />
          <text class="eh__del-text">删除</text>
        </view>
        <view class="eh__redo">
          <text>重做</text>
          <mg-icon name="chevron-right" size="28" color="#2E5E4E" />
        </view>
      </view>
    </view>

    <view class="eh__more">
      <mg-button
        title="再做一组练习"
        variant="secondary"
        size="lg"
        block
        icon="plus"
        bind:tap="goSetup"
      />
    </view>
  </block>

  <view class="eh__bottomspace"></view>
</view>
