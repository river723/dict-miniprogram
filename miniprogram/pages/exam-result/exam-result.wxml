<view class="mg-page er {{themeClass}}">

  <mg-empty
    wx:if="{{empty}}"
    icon="alert-circle-outline"
    title="没有练习结果"
    description="从练习中心开始一组 AI 出题练习吧。"
    action-label="去练习"
    bind:action="goPractice"
  />

  <block wx:else>
    <!-- 总览 -->
    <view class="er__summary">
      <text class="er__summary-label">练习完成！ · {{typeLabel}}</text>
      <text class="er__accuracy er__accuracy--{{accuracyCls}}">{{accuracyPercent}}%</text>
      <text class="er__summary-desc">{{summaryText}}</text>
    </view>

    <!-- 答题回顾 -->
    <view class="er__review-head">
      <text class="er__review-title">答题回顾</text>
    </view>

    <view wx:for="{{review}}" wx:key="idx" class="er__card">
      <view class="er__card-head">
        <view class="er__card-tags">
          <view class="er__tag er__tag--{{item.type}}">
            <text class="er__tag-text er__tag-text--{{item.type}}">{{item.typeLabel}}</text>
          </view>
          <text class="er__num">第 {{item.idx}} 题</text>
        </view>
        <text class="er__verdict er__verdict--{{item.verdictCls}}">{{item.verdict}}</text>
      </view>

      <view class="er__divider"></view>

      <!-- 释义单选 -->
      <block wx:if="{{item.isDefinition}}">
        <text class="er__sentence">{{item.sentence}}</text>
        <text wx:if="{{item.translation}}" class="er__translation">题干译文：{{item.translation}}</text>
        <view
          class="er__wordtag"
          hover-class="mg-hover"
          data-id="{{item.wordId}}"
          data-word="{{item.word}}"
          bindtap="openWord"
        >
          <text class="er__wordtag-text">目标词: {{item.word}}</text>
        </view>
        <text class="er__correct">正确答案：{{item.correct}}</text>
      </block>

      <!-- 完形选词 -->
      <block wx:else>
        <text class="er__sentence">{{item.sentence}}</text>
        <text wx:if="{{item.hint}}" class="er__hint">💡 {{item.hint}}</text>
        <text class="er__correct">正确答案：{{item.correct}}</text>
      </block>

      <text wx:if="{{item.showUser}}" class="er__user">你的选择：{{item.userAnswer}}</text>
    </view>

    <!-- 操作 -->
    <view class="er__actions">
      <mg-button title="再来一组" variant="primary" size="lg" block icon="refresh" bind:tap="again" />
      <mg-button
        wx:if="{{hasWrong}}"
        title="复习错题"
        variant="secondary"
        size="lg"
        block
        icon="alert-circle-outline"
        bind:tap="goWrong"
      />
      <mg-button title="返回练习" variant="secondary" size="lg" block icon="arrow-left" bind:tap="goPractice" />
      <view class="er__home" hover-class="mg-hover" bindtap="goHome">
        <text>返回首页</text>
      </view>
    </view>

    <view class="er__bottomspace"></view>
  </block>
</view>
