.er {
  min-height: 100vh;
  padding: 32rpx 32rpx 0;
  box-sizing: border-box;
}

/* ---------- 总览卡 ---------- */
.er__summary {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
  background: var(--mg-surface);
  border: 1rpx solid var(--mg-outline);
  border-radius: var(--mg-radius-lg);
  box-shadow: var(--mg-shadow-card);
}

.er__summary-label {
  font-size: 30rpx;
  color: var(--mg-text-2);
  margin-bottom: 16rpx;
}

.er__accuracy {
  font-size: 112rpx;
  line-height: 128rpx;
  font-weight: 800;
  letter-spacing: -2rpx;
  margin-bottom: 16rpx;
}
.er__accuracy--success { color: var(--mg-success); }
.er__accuracy--warning { color: var(--mg-warning); }
.er__accuracy--danger { color: var(--mg-danger); }

.er__summary-desc {
  font-size: 26rpx;
  line-height: 40rpx;
  text-align: center;
  color: var(--mg-text-3);
}

/* ---------- 回顾 ---------- */
.er__review-head { margin: 40rpx 0 20rpx; }

.er__review-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--mg-text);
}

.er__card {
  padding: 28rpx;
  margin-bottom: 20rpx;
  background: var(--mg-surface);
  border: 1rpx solid var(--mg-outline);
  border-radius: var(--mg-radius-lg);
  box-shadow: var(--mg-shadow-hairline);
}

.er__card-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.er__card-tags {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}

.er__tag {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}
.er__tag--definition { background: var(--mg-primary-container); }
.er__tag--cloze { background: var(--mg-warning-light); }

.er__tag-text { font-size: 22rpx; font-weight: 600; }
.er__tag-text--definition { color: var(--mg-primary); }
.er__tag-text--cloze { color: var(--mg-warning); }

.er__num {
  font-size: 26rpx;
  color: var(--mg-text-3);
}

.er__verdict {
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 700;
}
.er__verdict--ok { color: var(--mg-success); }
.er__verdict--bad { color: var(--mg-danger); }
.er__verdict--none { color: var(--mg-text-3); }

.er__divider {
  height: 1rpx;
  margin: 20rpx 0;
  background: var(--mg-outline);
  opacity: 0.6;
}

.er__sentence {
  display: block;
  font-size: 29rpx;
  line-height: 48rpx;
  font-style: italic;
  margin-bottom: 12rpx;
  color: var(--mg-text-2);
}

.er__translation {
  display: block;
  font-size: 26rpx;
  line-height: 40rpx;
  margin-bottom: 12rpx;
  color: var(--mg-primary);
}

.er__wordtag { margin-bottom: 8rpx; }

.er__wordtag-text {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--mg-primary);
  text-decoration: underline;
}

.er__hint {
  display: block;
  font-size: 24rpx;
  line-height: 36rpx;
  margin-bottom: 12rpx;
  color: var(--mg-text-3);
}

.er__correct {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--mg-success);
}

.er__user {
  display: block;
  margin-top: 6rpx;
  font-size: 28rpx;
  color: var(--mg-danger);
}

/* ---------- 操作 ---------- */
.er__actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 24rpx;
}

.er__home {
  padding: 24rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--mg-primary);
}

.er__bottomspace { height: 64rpx; }
