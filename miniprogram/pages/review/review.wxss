.page { padding: 32rpx; display: flex; flex-direction: column; gap: 24rpx; min-height: 100vh; box-sizing: border-box; }
.progress { text-align: center; }

.card { text-align: center; padding: 80rpx 32rpx; }
.word { font-size: 72rpx; font-weight: 700; letter-spacing: 2rpx; }
.phonetic { margin-top: 8rpx; }
.hint { margin-top: 48rpx; }
.defs { margin-top: 40rpx; text-align: left; }
.def { margin-bottom: 16rpx; line-height: 44rpx; }
.pos { color: var(--mg-primary); margin-right: 16rpx; font-style: italic; }

.ai-head { display: flex; justify-content: space-between; font-weight: 600; }
.ai-block { margin-top: 16rpx; font-size: 26rpx; color: var(--mg-text-2); }
.ai-label { color: var(--mg-accent); font-weight: 600; margin-right: 12rpx; }
.obscure { color: var(--mg-text); }

.actions { display: flex; gap: 24rpx; margin-top: auto; }
.act { flex: 1; }
.known { background: var(--mg-primary); color: #fff; }
.unknown { background: var(--mg-accent-light); color: var(--mg-accent-dark); }

.done { text-align: center; padding: 96rpx 32rpx; }
.done-title { font-size: 40rpx; font-weight: 700; margin-bottom: 24rpx; }
.done-row { margin-bottom: 48rpx; }
.ok { color: var(--mg-success); font-weight: 700; }
.bad { color: var(--mg-danger); font-weight: 700; }
.done-btn { margin: 0 64rpx; }
