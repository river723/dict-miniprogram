.wp { min-height: 100vh; }

/* ---------- 顶部 ---------- */
.wp__top { padding: 24rpx 32rpx 8rpx; }

.wp__stats {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 20rpx;
  padding: 20rpx 0;
  background: var(--mg-surface);
  border: 1rpx solid var(--mg-outline);
  border-radius: var(--mg-radius-md);
}

.wp__stat {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.wp__statnum {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--mg-text);
}

.wp__statnum--on { color: var(--mg-accent); }

.wp__statlbl {
  font-size: 20rpx;
  color: var(--mg-text-3);
}

.wp__sep {
  width: 1rpx;
  height: 48rpx;
  background: var(--mg-hairline);
}

.wp__tools {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
}

.chip {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  height: 60rpx;
  padding: 0 22rpx;
  font-size: 24rpx;
  color: var(--mg-text-2);
  background: var(--mg-surface);
  border: 1rpx solid var(--mg-outline);
  border-radius: 999rpx;
}

.chip--on {
  background: var(--mg-primary-container);
  border-color: var(--mg-primary);
  color: var(--mg-primary);
  font-weight: 600;
}

.ph { color: var(--mg-text-3); }

/* ---------- 列表 ---------- */
.wp__list { padding: 8rpx 32rpx 0; }

.row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 16rpx;
  padding: 24rpx;
  background: var(--mg-surface);
  border: 1rpx solid var(--mg-outline);
  border-radius: var(--mg-radius-lg);
}

.row--on {
  border-color: var(--mg-primary);
  background: var(--mg-primary-light);
}

.row__check { padding-top: 2rpx; }

.row__body { flex: 1; min-width: 0; }

.row__line1 {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 12rpx;
}

.row__word {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--mg-text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.row--on .row__word { color: var(--mg-primary); }

.row__ph {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: var(--mg-text-3);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.row__meaning {
  display: -webkit-box;
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 40rpx;
  color: var(--mg-text-2);
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.row__meta {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
}

.row__diff { font-size: 20rpx; letter-spacing: 1rpx; }
.row__freq { font-size: 20rpx; letter-spacing: 1rpx; color: var(--mg-text-3); }

.row__ignore { padding: 4rpx; margin-top: -4rpx; }

/* ---------- 分组翻页 ---------- */
.wp__pager {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  padding: 24rpx 0 8rpx;
}

.pager__btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--mg-surface);
  border: 1rpx solid var(--mg-outline);
}

.pager__btn--off { opacity: 0.35; }

.pager__label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--mg-text-2);
}

.wp__bottomspace { height: 220rpx; }

/* ---------- 底部操作条 ---------- */
.wp__bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--mg-surface);
  border-top: 1rpx solid var(--mg-hairline);
  box-shadow: var(--mg-shadow-raised);
}

.wp__barcount {
  font-size: 26rpx;
  color: var(--mg-text-2);
}

.wp__barcount--num {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--mg-primary);
}

/* ---------- 排序弹层 ---------- */
.picker { width: 100%; margin-top: 24rpx; }

.picker__item {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding: 26rpx 8rpx;
  font-size: 30rpx;
  color: var(--mg-text);
  border-bottom: 1rpx solid var(--mg-hairline);
}

.picker__item:last-child { border-bottom: none; }

.picker__item--on {
  color: var(--mg-primary);
  font-weight: 700;
}
