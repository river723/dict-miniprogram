<view class="mg-page wq {{themeClass}}">

  <view class="wq__summary">
    <text class="wq__summary-title">单词错题 · 共 {{wordTotal}} 题</text>
    <text class="wq__summary-desc">释义单选 {{wordDef}} · 完形选词 {{wordCloze}} · 掌握 {{threshold}} 次后自动移除</text>
  </view>

  <mg-empty
    wx:if="{{wordTotal === 0}}"
    icon="party-popper"
    title="太棒了！没有错题"
    description="继续保持，多做练习巩固。"
    action-label="去做一组练习"
    bind:action="goSetup"
  />

  <block wx:else>
    <view class="wq__filters">
      <view class="seg3">
        <view
          wx:for="{{typeFilters}}"
          wx:key="key"
          class="seg3__item {{typeFilter === item.key ? 'seg3__item--on' : ''}}"
          hover-class="mg-hover-soft"
          data-key="{{item.key}}"
          bindtap="setTypeFilter"
        >{{item.label}}</view>
      </view>
      <view class="seg3">
        <view
          wx:for="{{countFilters}}"
          wx:key="key"
          class="seg3__item {{wrongCountFilter === item.key ? 'seg3__item--on' : ''}}"
          hover-class="mg-hover-soft"
          data-key="{{item.key}}"
          bindtap="setCountFilter"
        >{{item.label}}</view>
      </view>
    </view>

    <view class="wq__redo">
      <mg-button
        title="重做（{{filtered.length}} 题）"
        variant="primary"
        size="lg"
        block
        icon="play-circle"
        disabled="{{filtered.length === 0}}"
        bind:tap="startReview"
      />
    </view>

    <view wx:for="{{filtered}}" wx:key="id" class="wq__card">
      <view class="wq__card-head">
        <view class="tag tag--{{item.type}}">
          <text class="tag__text tag__text--{{item.type}}">{{item.typeLabel}}</text>
        </view>
        <view class="wq__counts">
          <text class="wq__wrong-count">错 {{item.wrongCount}} 次</text>
          <text wx:if="{{item.hasCorrect}}" class="wq__correct-count">对 {{item.correctCount}}/{{threshold}}</text>
        </view>
      </view>

      <view class="wq__divider"></view>

      <text class="wq__sentence">{{item.sentence}}</text>
      <text wx:if="{{item.translation}}" class="wq__translation">题干译文：{{item.translation}}</text>
      <text wx:if="{{item.hint}}" class="wq__hint">💡 {{item.hint}}</text>

      <view
        class="wq__wordtag"
        hover-class="mg-hover"
        data-id="{{item.wordId}}"
        data-word="{{item.word}}"
        bindtap="openWord"
      >
        <text class="wq__wordtag-text">目标词：{{item.word}}</text>
      </view>

      <text class="wq__correct">✓ {{item.correct}}</text>
      <text class="wq__wrong">✗ 你的选择：{{item.wrongAnswer}}</text>
    </view>
  </block>

  <view class="wq__bottomspace"></view>
</view>
