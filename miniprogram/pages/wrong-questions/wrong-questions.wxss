.page { padding: 32rpx; }
.item { margin-bottom: 16rpx; }
.head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8rpx; }
.w { font-size: 34rpx; font-weight: 600; }
.count { background: var(--mg-accent-light); color: var(--mg-accent-dark); }
