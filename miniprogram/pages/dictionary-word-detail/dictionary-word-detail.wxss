.dwd {
  min-height: 100vh;
  padding: 24rpx 32rpx 64rpx;
  box-sizing: border-box;
}

.card {
  margin-bottom: 24rpx;
  padding: 32rpx;
  background: var(--mg-surface);
  border: 1rpx solid var(--mg-outline);
  border-radius: var(--mg-radius-lg);
  box-shadow: var(--mg-shadow-card);
}

.card__title {
  display: block;
  margin-bottom: 16rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--mg-text);
}

.card__text {
  display: block;
  font-size: 28rpx;
  line-height: 46rpx;
  color: var(--mg-text);
}

.card__empty {
  display: block;
  font-size: 26rpx;
  color: var(--mg-text-3);
}

/* ---------- 单词头 ---------- */
.dwd__head {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.dwd__info { flex: 1; min-width: 0; }

.dwd__word {
  display: block;
  font-size: 64rpx;
  font-weight: 700;
  line-height: 80rpx;
  color: var(--mg-primary);
  word-break: break-all;
}

.dwd__ph {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
  color: var(--mg-text-2);
}

.dwd__speak {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--mg-primary-light);
}

.dwd__meta {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  margin-top: 20rpx;
}

.dwd__meta-badge { font-size: 24rpx; letter-spacing: 1rpx; }
.dwd__meta-freq { font-size: 24rpx; letter-spacing: 1rpx; color: var(--mg-text-2); }

/* ---------- 释义 ---------- */
.def {
  margin-bottom: 20rpx;
  padding: 24rpx;
  background: var(--mg-bg);
  border-radius: var(--mg-radius-md);
}

.def:last-child { margin-bottom: 0; }

.def__head {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.def__pos {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--mg-text-2);
}

.def__meaning {
  display: block;
  font-size: 28rpx;
  line-height: 44rpx;
  color: var(--mg-text);
}

.def__example {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 38rpx;
  color: var(--mg-text-2);
}

/* ---------- 相似词 ---------- */
.sim { margin-bottom: 20rpx; }
.sim:last-child { margin-bottom: 0; }

.sim__word {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--mg-text);
}

.sim__desc {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 36rpx;
  color: var(--mg-text-2);
}

/* ---------- 操作 ---------- */
.dwd__actions {
  margin-top: 8rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.dwd__back {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  font-size: 28rpx;
  color: var(--mg-primary);
}
