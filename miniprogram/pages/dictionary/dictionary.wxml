<view class="mg-page dict {{themeClass}}">

  <view class="dict__sub">
    <text>选择一个词库作为自动配词来源，或打开浏览全部单词</text>
  </view>

  <view class="dict__list">
    <view
      wx:for="{{dicts}}"
      wx:key="id"
      class="dcard {{item.active ? 'dcard--active' : ''}}"
    >
      <view class="dcard__head">
        <view class="dcard__title">
          <text class="dcard__name">{{item.name}}</text>
          <view wx:if="{{item.active}}" class="dcard__check">
            <mg-icon name="check" size="28" color="#2E5E4E" />
            <text>使用中</text>
          </view>
        </view>
        <view class="dcard__badge"><text>{{item.countText}}</text></view>
      </view>

      <text class="dcard__desc">{{item.desc}}</text>

      <view class="dcard__actions">
        <mg-button
          wx:if="{{!item.active}}"
          title="设为本词库"
          variant="secondary"
          size="md"
          icon="check-decagram-outline"
          data-value="{{item.id}}"
          bind:tap="onLibraryChange"
        />
        <mg-button
          title="打开"
          variant="primary"
          size="md"
          icon="book-open-variant"
          data-id="{{item.id}}"
          bind:tap="openDict"
        />
      </view>
    </view>

    <view wx:if="{{error}}" class="dict__err">
      <mg-icon name="alert-circle-outline" size="32" color="#B5462E" />
      <text>{{error}}</text>
    </view>
  </view>
</view>
