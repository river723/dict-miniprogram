.page { padding: 32rpx; }

.tabs { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.tab { padding: 12rpx 32rpx; border-radius: 999rpx; background: var(--mg-surface); border: 1rpx solid var(--mg-hairline); color: var(--mg-text-2); }
.tab.on { background: var(--mg-primary); color: #fff; border-color: var(--mg-primary); }

.word-row { margin-bottom: 16rpx; }
.word-main { display: flex; align-items: center; gap: 16rpx; }
.word { font-size: 34rpx; font-weight: 600; }
.freq { background: var(--mg-primary-light); color: var(--mg-primary-dark); }
.def-line { margin-top: 8rpx; font-size: 26rpx; }

.search-bar { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.search-input { flex: 1; background: var(--mg-surface); border: 1rpx solid var(--mg-hairline); border-radius: 16rpx; padding: 0 24rpx; height: 88rpx; }
.search-btn { width: 180rpx; height: 88rpx; }

.add-btn { margin-top: 16rpx; color: var(--mg-primary); font-weight: 600; font-size: 26rpx; }
.empty { text-align: center; padding: 96rpx 32rpx; }
